ngx_addon_name=ngx_http_secure_hls_module
ngx_module_type=HTTP_FILTER
ngx_module_name=ngx_http_secure_hls_module
ngx_module_srcs="$ngx_addon_dir/src/ngx_http_secure_hls_module.c"
ngx_module_libs="-lcrypto"
# Registration is reversed at runtime: copy -> HLS -> gzip -> range.
ngx_module_order="ngx_http_secure_hls_module ngx_http_copy_filter_module"

if test -n "$ngx_module_link"; then
    . auto/module
else
    HTTP_FILTER_MODULES="$HTTP_FILTER_MODULES ngx_http_secure_hls_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_module_srcs"
    CORE_LIBS="$CORE_LIBS -lcrypto"
fi
